# Apalancamiento (1-125x, recomendado: 3-10x)
# 🛡️ CONSERVADOR: 3x = Menor riesgo de liquidación
LEVERAGE=3

# Porcentaje de riesgo por trade (1-5% recomendado)
# Con 5000 USDT y 0.5% = $25 de riesgo por trade
# 🛡️ CONSERVADOR: 0.5% = Riesgo muy bajo por trade
RISK_PERCENT=0.5

# Máximo número de posiciones simultáneas
# 🛡️ CONSERVADOR: 2 = Evita sobre-exposición
