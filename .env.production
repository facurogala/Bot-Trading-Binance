# ==============================
# PRODUCCION (dinero real)
# ==============================

# Telegram
TELEGRAM_TOKEN=REEMPLAZAR
TELEGRAM_CHAT_ID=REEMPLAZAR

# Binance (PROD keys)
BINANCE_API_KEY=REEMPLAZAR_PROD_KEY
BINANCE_API_SECRET=REEMPLAZAR_PROD_SECRET
TESTNET=False

# Trading base
AUTO_TRADE_ENABLED=False
USE_MARKET_ORDER=False
LEVERAGE=2
RISK_PERCENT=0.25
MAX_POSITIONS=1
RISK_ON_AVAILABLE=True

# Risk profile / guard
RISK_PROFILE=CONSERVATIVE
RISK_GUARD_ENABLED=True
MAX_DAILY_LOSS_USDT=50
MAX_CONSECUTIVE_LOSSES=3
MAX_DRAWDOWN_PCT=12
RISK_GUARD_PAUSE_MINUTES=180
RISK_GUARD_INITIAL_EQUITY_USDT=1000
MAX_GLOBAL_OPEN_POSITIONS=3
MAX_GLOBAL_SYMBOL_POSITIONS=1
MAX_GLOBAL_EXPOSURE_USDT=0
MAX_SYMBOL_EXPOSURE_USDT=0

# Orders / monitoring
ENABLE_ORDER_MONITORING=True
ORDER_MONITOR_DURATION=900
ORDER_MONITOR_INTERVAL=15
ORDER_FILL_TIMEOUT=30

# Dynamic SL (Swing)
DYNAMIC_SL_ENABLED=True
BREAKEVEN_ON_TP1=True
BREAKEVEN_OFFSET_PCT=0.0
TRAILING_ATR_ENABLED=True
TRAILING_ATR_MULT=1.2
TRAILING_ATR_TIMEFRAME=1h
MIN_SL_MOVE_PERCENT=0.002

# Dynamic SL (Scalping)
SCALPING_DYNAMIC_SL_ENABLED=True
SCALPING_BREAKEVEN_ON_TP1=True
SCALPING_BREAKEVEN_OFFSET_PCT=0.0
SCALPING_TRAILING_ATR_ENABLED=True
SCALPING_TRAILING_ATR_MULT=0.8
SCALPING_TRAILING_ATR_TIMEFRAME=15m
SCALPING_MIN_SL_MOVE_PERCENT=0.0007

# Dynamic SL (Haack)
HAACK_DYNAMIC_SL_ENABLED=True
HAACK_BREAKEVEN_ON_TP1=True
HAACK_BREAKEVEN_OFFSET_PCT=0.0
HAACK_TRAILING_ATR_ENABLED=True
HAACK_TRAILING_ATR_MULT=1.4
HAACK_TRAILING_ATR_TIMEFRAME=4h
HAACK_MIN_SL_MOVE_PERCENT=0.0015
